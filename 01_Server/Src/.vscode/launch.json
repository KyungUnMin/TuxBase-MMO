{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GameServer (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Linux/03_ServerApp/GameServer",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
