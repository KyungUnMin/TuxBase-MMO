{
    "version": "2.0.0",
    "tasks": 
    [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": 
            [
                "-S",".",
                "-B","build/Linux",
                "-G","Ninja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build","build/Linux","-j"
            ],
            "group": "build",
            "problemMatcher": 
            [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Full Build",
            "dependsOn": 
            [
                "CMake: Configure",
                "CMake: Build"
            ],
            "dependsOrder": "sequence",
            "group": 
            {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}